# Copy to .env.local and adjust: cp .env.local.example .env.local
# Next loads .env.local (git-ignored); variables already set in the environment win.

# PostgreSQL. Default: local socket, your OS user as the database role.
# Create and seed it with the history-of-db repo (../history-of-db/scripts/migrate.sh --seed).
DATABASE_URL=postgresql:///history_of?host=/var/run/postgresql

# Neon (production) credentials live in .env.production, which `next build` and
# `next start` load and `next dev` doesn't, so dev stays on local Postgres.
# Refresh them with (plain `neon deploy` / `neon env pull` write .env.local):
#   neon deploy --no-env-pull && neon env pull --file .env.production
# Variables written:
#   DATABASE_URL           pooled; the app uses this one
#   DATABASE_URL_UNPOOLED  direct; for migrations/pg_dump, not read by the app
#   NEON_BRANCH, NEON_BRANCH_ID, NEON_FUNCTION_HOST_SUFFIX
# Schema and seeds go in with ../history-of-db/neon/setup.sh --seed.

# Public origin for canonical links, the sitemap, JSON-LD and the share image.
# Required in production: cached pages can't read the request's host.
# SITE_URL=https://historyof.example

# Comma-separated *other* browser origins allowed to call /v1. The app's own
# pages are same-origin and don't need it.
# CORS_ORIGIN=

# Port for `npm start`. Read by the shell, so export it rather than relying on .env.local.
# WEB_PORT=3000
